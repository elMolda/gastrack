# GasTrack — PRODUCTION secrets
# NOT used by Docker. Paste these into Cloudflare Pages → Settings → Environment variables.
# This file is gitignored. Copy from .env.production.example if missing.

# --- Neon Postgres (pooled "-pooler" connection string) ---
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# --- Better Auth (production) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-production-random-secret
BETTER_AUTH_URL=https://gastrack.elmoldasoft.us

# --- Google OAuth ---
# Redirect: https://gastrack.elmoldasoft.us/api/auth/callback/google
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=gastrack-photos
R2_PUBLIC_URL=https://photos.gastrack.elmoldasoft.us
