{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/sveltekit"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": ".svelte-kit/output",
  "installCommand": "npm install",
  "framework": "sveltekit-1"
}
