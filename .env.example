# ==========================================================================
# GasTrack environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ==========================================================================

# --------------------------------------------------------------------------
# Current stack (Supabase) — used until the Neon/Better Auth migration lands
# --------------------------------------------------------------------------
# 1. Go to https://supabase.com and open your project
# 2. Project Settings > API
# 3. Copy the "Project URL" and the "anon" public key
PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --------------------------------------------------------------------------
# Target stack (Neon + Better Auth + Google + R2) — migration branch
# --------------------------------------------------------------------------

# Postgres connection string.
# Neon (prod / edge): pooled URL from Dashboard > Connection Details (-pooler host).
# Local Drizzle DB:  docker compose -f docker-compose.drizzle.yml up -d
#   postgresql://gastrack:gastrack@127.0.0.1:5433/gastrack
#
# The app client uses Neon HTTP for *.neon.tech URLs, and postgres.js TCP otherwise.
DATABASE_URL=postgresql://gastrack:gastrack@127.0.0.1:5433/gastrack

# Better Auth
# BETTER_AUTH_SECRET: generate locally with `openssl rand -base64 32`.
# Keep it stable per environment; rotating it logs everyone out.
BETTER_AUTH_SECRET=your-generated-random-secret
# Base URL of the app for this environment (no trailing slash).
# Local dev:  http://localhost:5173
# Production: https://gastrack.elmoldasoft.us
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI must be: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Cloudflare R2 (object storage for car photos)
# R2 dashboard > Manage R2 API Tokens. Account ID is in the R2 overview URL.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=gastrack-photos
# Public base URL for serving photos (R2 public bucket or custom domain).
R2_PUBLIC_URL=https://photos.gastrack.elmoldasoft.us
