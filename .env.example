# ==========================================================================
# GasTrack environment files
# ==========================================================================
#
# Two secret files (both gitignored):
#
#   .env.local         → used by Docker local stack
#                        docker compose up --build
#
#   .env.production    → real Neon / Google / R2 values
#                        paste into Cloudflare Pages env vars (not Docker)
#
# Setup once:
#   cp .env.local.example .env.local
#   cp .env.production.example .env.production
#   # fill real values
#
# See .env.local.example / .env.production.example for the full key list.
