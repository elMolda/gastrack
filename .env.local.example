# GasTrack — LOCAL (Docker Compose) profile
# Loaded automatically by: docker compose -f docker-compose.local.yml up
# This file is gitignored. Copy from .env.local.example if missing.
#
# Compose overrides DATABASE_URL inside containers to use hostname `postgres`.
# The 127.0.0.1 URL below is only for rare host-side DB tools.

# --- Legacy Supabase (unused once Better Auth cutover is complete) ---
PUBLIC_SUPABASE_URL=http://localhost:8000
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWxvY2FsIiwiaWF0IjoxNzY3MjI1NjAwLCJleHAiOjIwODI3NTg0MDB9.-dVcEDTrFKnPg11HtvDdwsg3F2vYFKZ0ppjAEd4qw-Q

# --- Drizzle / Postgres ---
DATABASE_URL=postgresql://gastrack:gastrack@127.0.0.1:5433/gastrack

# --- Better Auth (local) ---
# Deterministic local-only secret — do NOT reuse in production.
BETTER_AUTH_SECRET=local-dev-better-auth-secret-change-me-32b
BETTER_AUTH_URL=http://localhost:5173

# --- Google OAuth ---
# Register redirect: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# --- Cloudflare R2 (optional locally) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gastrack-photos-local
R2_PUBLIC_URL=http://localhost:5173/r2-dev
